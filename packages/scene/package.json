{
  "name": "@trempel/scene",
  "version": "2.3.0",
  "description": "Trempel \u2014 agent-first 2D game scenes: a scene format that is valid SVG (+ tml: namespace), a PixiJS runtime, an animation player and an editor core.",
  "type": "module",
  "license": "MIT",
  "author": "Denys Vynohradskyi",
  "homepage": "https://trempel.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trempel-dev/trempel.git",
    "directory": "packages/scene"
  },
  "bugs": {
    "url": "https://github.com/trempel-dev/trempel/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    },
    "./edit": {
      "types": "./dist/edit/types/edit/lib.d.ts",
      "import": "./dist/edit/index.js"
    },
    "./edit/index.html": "./dist/edit/index.html",
    "./edit/style.css": "./dist/edit/style.css",
    "./package.json": "./package.json",
    "./browser": "./dist/browser/trempel.js",
    "./browser/core": "./dist/browser/trempel-core.js",
    "./browser/editor": "./dist/browser/trempel-editor.js",
    "./internal/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "bin": {
    "trempel-flatten": "dist/node/flatten-cli.js",
    "trempel-view": "view/bin.mjs",
    "scene": "view/bin.mjs",
    "trempel-edit": "view/edit-bin.mjs"
  },
  "files": [
    "dist",
    "view",
    "!view/**/*.test.*",
    "!view/tsconfig.json",
    "src",
    "edit",
    "!edit/**/*.test.*",
    "!edit/e2e",
    "!edit/tsconfig*.json",
    "!edit/lib.config.ts",
    "editor",
    "!editor/**/*.test.*",
    "!editor/tsconfig*.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p editor/tsconfig.build.json && npm run build:edit",
    "typecheck": "tsc --noEmit && tsc -p examples/motion/tsconfig.json && tsc -p examples/prefabs/tsconfig.json && tsc -p examples/finddiff/tsconfig.json && tsc -p view/tsconfig.json && tsc -p editor/tsconfig.json && tsc -p edit/tsconfig.json",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run --project unit && vitest run --project e2e",
    "test:watch": "vitest",
    "check": "npm run build && node scripts/check.mjs",
    "anim:compile": "npm run build && node scripts/anim-compile.mjs",
    "flatten": "npm run build && node dist/node/flatten-cli.js",
    "dev": "vite",
    "view": "node view/cli.mjs",
    "view:shot": "node view/shot.mjs",
    "edit": "node edit/cli.mjs",
    "editor:commands": "npm run build && node scripts/editor-commands.mjs",
    "build:browser": "vite build --config vite.browser.config.ts",
    "build:edit": "vite build --config edit/lib.config.ts && tsc -p edit/tsconfig.lib.json",
    "prepack": "npm run build && npm run build:browser",
    "error-codes": "node scripts/error-codes.mjs",
    "visual-gate": "node scripts/visual-gate.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.6",
    "svg-path-properties": "^2.1.0"
  },
  "devDependencies": {
    "pixi.js": "^8.19.0"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "pixi.js": "^8.19.0",
    "vite": "^6.0.0",
    "playwright": "^1.50.0"
  },
  "peerDependenciesMeta": {
    "pixi.js": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "keywords": [
    "pixijs",
    "svg",
    "game",
    "scene",
    "editor",
    "agent-first",
    "trempel"
  ]
}
