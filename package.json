{
  "name": "@trempel/scene",
  "version": "1.0.0",
  "description": "Trempel — agent-first 2D game scenes: a scene format that is valid SVG (+ tml: namespace), a PixiJS runtime, an animation player and an editor core.",
  "type": "module",
  "license": "MIT",
  "author": "Denys Vynohradskyi",
  "homepage": "https://trempel.dev",
  "repository": "github:trempel-dev/trempel",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./edit": {
      "types": "./dist/edit/types/edit/lib.d.ts",
      "import": "./dist/edit/index.js"
    },
    "./edit/index.html": "./dist/edit/index.html",
    "./edit/style.css": "./dist/edit/style.css",
    "./package.json": "./package.json",
    "./browser": "./dist/browser/trempel.js",
    "./browser/core": "./dist/browser/trempel-core.js",
    "./browser/editor": "./dist/browser/trempel-editor.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc -p editor/tsconfig.build.json && npm run build:edit",
    "typecheck": "tsc --noEmit && tsc -p examples/motion/tsconfig.json && tsc -p examples/prefabs/tsconfig.json && tsc -p examples/finddiff/tsconfig.json && tsc -p view/tsconfig.json && tsc -p editor/tsconfig.json && tsc -p edit/tsconfig.json",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run --project unit && vitest run --project e2e",
    "test:watch": "vitest",
    "check": "npm run build && node scripts/check.mjs",
    "anim:compile": "npm run build && node scripts/anim-compile.mjs",
    "dev": "vite",
    "view": "node view/cli.mjs",
    "view:shot": "node view/shot.mjs",
    "edit": "node edit/cli.mjs",
    "editor:commands": "npm run build && node scripts/editor-commands.mjs",
    "build:browser": "vite build --config vite.browser.config.ts",
    "build:edit": "vite build --config edit/lib.config.ts && tsc -p edit/tsconfig.lib.json",
    "prepack": "npm run build && npm run build:browser"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.6",
    "svg-path-properties": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "pixi.js": "^8.5.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "pixi.js": "^8.5.0"
  },
  "peerDependenciesMeta": {
    "pixi.js": {
      "optional": true
    }
  },
  "keywords": [
    "pixijs",
    "svg",
    "game",
    "scene",
    "editor",
    "agent-first",
    "trempel"
  ]
}
